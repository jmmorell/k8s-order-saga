# Pinned versions for the local cluster; sourced by scripts/local-up.sh.
NATS_CHART_VERSION=2.15.2
# kind reads the node image from deploy/local/kind-cluster.yaml (it cannot read env vars);
# local-up.sh fails if the two differ.
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5
# Image tags below are set literally in deploy/local/platform/*.yaml; keep them in sync.
POSTGRES_IMAGE=postgres:17-alpine
MAILPIT_IMAGE=axllent/mailpit:v1.33.1
ENVOY_GATEWAY_VERSION=1.10.0
# Observability (ADR 0008). Each chart's images are its defaults, pinned by the chart version.
KUBE_PROMETHEUS_STACK_VERSION=93.9.0
TEMPO_CHART_VERSION=3.2.1
LOKI_CHART_VERSION=21.6.0
OTEL_COLLECTOR_CHART_VERSION=0.183.1
METRICS_SERVER_CHART_VERSION=3.14.0
# Argo CD (ADR 0010), chart argo-cd from https://argoproj.github.io/argo-helm (app v3.6.3).
ARGOCD_CHART_VERSION=10.20.0
# Same Prometheus release as kube-prometheus-stack deploys; used for promtool.
PROMETHEUS_IMAGE=quay.io/prometheus/prometheus:v3.16.0
# Secret scan over the git history (scripts/secrets-scan.sh).
GITLEAKS_IMAGE=ghcr.io/gitleaks/gitleaks:v8.30.1@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f
# Probe pods of scripts/policy-test.sh (NetworkPolicy checks); runs as uid 100, gid 101.
CURL_IMAGE=curlimages/curl:8.17.0@sha256:935d9100e9ba842cdb060de42472c7ca90cfe9a7c96e4dacb55e79e560b3ff40
# CI (.github/workflows and make ci-local); the workflows load these lines into their environment.
# GitHub Actions themselves are pinned by commit SHA in the workflow files.
GOLANGCI_LINT_VERSION=v2.15.0
HELM_VERSION=v4.3.2
KUBECONFORM_VERSION=v0.8.0
ACTIONLINT_IMAGE=rhysd/actionlint:1.7.12@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667
TRIVY_IMAGE=ghcr.io/aquasecurity/trivy:0.76.2@sha256:8f6bb947dbc528902e11f2f5be52f7b519f6a39d5d148f41166f2040499768fb
